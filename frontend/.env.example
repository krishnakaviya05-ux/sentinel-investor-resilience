# ─── Frontend Environment Variables ───────────────────────────────────
#
# VITE_API_BASE_URL
#   URL of the deployed SENTINEL backend.
#   Local dev:   http://localhost:8000
#   Production:  https://your-sentinel-backend.onrender.com
#
# IMPORTANT: Never put LLM API keys or secrets in this file.
# All LLM credentials belong exclusively on the backend.
#
VITE_API_BASE_URL=http://localhost:8000
