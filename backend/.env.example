# ─── Application ──────────────────────────────────────────────────────
APP_NAME=SENTINEL
APP_VERSION=1.0.0

# ─── Server ───────────────────────────────────────────────────────────
# Automatically set by hosting platforms (Render, Railway, Fly.io, etc.)
# Leave unset for local development (defaults to 8000).
# PORT=8000

# ─── LLM Provider (OpenAI-compatible) ─────────────────────────────────
# Set your API key here. Leave blank to run in deterministic fallback mode.
LLM_API_KEY=

# Model to use. Examples:
#   OpenAI:   gpt-4o-mini  /  gpt-4o
#   Groq:     qwen/qwen3.8-27b
#   Together: meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
LLM_MODEL=gpt-4o-mini

# Base URL of the OpenAI-compatible API — WITHOUT trailing slash.
# OpenAI:   https://api.openai.com/v1
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
LLM_BASE_URL=https://api.openai.com/v1

# Timeout for LLM requests (seconds)
LLM_TIMEOUT_SECONDS=30

# ─── CORS ─────────────────────────────────────────────────────────────
# Set to your deployed frontend URL in production.
# Example: https://sentinel-app.vercel.app
# localhost:5173 is always allowed for local development.
FRONTEND_URL=

# Legacy multi-origin override (comma-separated). Usually not needed.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
